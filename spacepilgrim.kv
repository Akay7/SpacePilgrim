#:import metrics kivy.metrics
#:import Window kivy.core.window.Window
#:import Vector kivy.vector.Vector

<Explosion>:
    size: 128, 128
    canvas:
        Ellipse:
            texture: self.texture
            pos: self.pos
            size: self.size


<Asteroid>:
    size: 90, 90
    canvas:
        Ellipse:
            source: "images/asteroid_blue.png"
            pos: self.pos
            size: self.size

    canvas.before:
        PushMatrix
        Rotate:
            angle: self.angle
            origin: self.center
    canvas.after:
        PopMatrix


<Shot>
    size: 10, 10
    canvas:
        Ellipse:
            source: "images/shot1.png"
            pos: self.pos
            size: self.size


<Spaceship>:
    size: 90, 90

    canvas.before:
        PushMatrix
        Rotate:
            angle: self.angle
            origin: self.center
    canvas.after:
        PopMatrix

    canvas:
        Color:
            rgba: 1, 1, 1, 1
        Ellipse:
            texture: self.texture_fly if self.thrust else self.texture_stop
            pos: self.pos
            size: self.size


<SpaceshipStatus>:
    Label:
        id: text_label
        # one player: top right. Multiplayer: a touch player's block is at
        # the middle of their side, just inside their touch controls (the
        # turned text is one line high across), turned so that it reads
        # right from their seat (the touch players sit at opposite sides:
        # left one faces right, right one left); keyboard and gamepad players
        # sit in front of the screen and get a column of the top row, in
        # player order
        center_x: root.inset + self.texture_size[1] / 2 if root.side == 'left' else (Window.width - root.inset - self.texture_size[1] / 2 if root.side == 'right' else (Window.width * (root.column + 0.5) / 4 if root.side == 'top' else Window.width - metrics.dp(210)))
        center_y: Window.height / 2 if root.side in ('left', 'right') else Window.height - 50
        canvas.before:
            PushMatrix
            Rotate:
                angle: -90 if root.side == 'left' else (90 if root.side == 'right' else 0)
                origin: self.center
        canvas.after:
            PopMatrix
        color: root.color
        text: ("Lives {}  Points {}" if root.side == 'top' else "Lives {:<5} Points {}").format(root.spaceship.lives, root.spaceship.points)
        font_size: "17dp" if root.side == 'top' else "23dp"
        font_name: 'data/fonts/RobotoMono-Regular.ttf'

    PauseButton:
        # under the lives and points as the player reads them: below the
        # text for one player; for a touch player's turned text (middle of
        # their side, between their two controls) on the screen-edge side
        text: "Pause"
        font_size: "12dp"
        background_normal: ''
        background_down: ''
        background_color: 0, 0, 0, 0
        size_hint: None, None
        size: metrics.dp(44), metrics.dp(44)
        opacity: 1 if root.show_menu else 0
        disabled: not root.show_menu
        center_x: text_label.center_x if root.side == '' else (text_label.center_x - text_label.texture_size[1] / 2 - metrics.dp(28) if root.side == 'left' else text_label.center_x + text_label.texture_size[1] / 2 + metrics.dp(28))
        center_y: text_label.center_y - text_label.texture_size[1] / 2 - metrics.dp(28) if root.side == '' else text_label.center_y
        on_press: root.parent.pause()
        canvas.before:
            PushMatrix
            Rotate:
                angle: -90 if root.side == 'left' else (90 if root.side == 'right' else 0)
                origin: self.center
            # same rounded blue outline as the join screen's side strips
            Color:
                rgba: 1, 1, 1, 0.3 if self.state == 'down' else 0
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [metrics.dp(10)]
            Color:
                rgba: 0.3, 0.6, 1, 1
            Line:
                width: metrics.dp(1.5)
                rounded_rectangle: self.x, self.y, self.width, self.height, metrics.dp(10)
        canvas.after:
            PopMatrix


<Menu>:
    orientation: "vertical"
    spacing: metrics.dp(10)
    size: metrics.dp(300), metrics.dp(340)
    pos: (Vector(*Window.size) - Vector(*self.size)) / 2

    Button:
        text: "Single player"
        on_press: root.parent.show_ship_select(1)

    Button:
        text: "Multiplayer"
        on_press: root.parent.show_ship_select(2)

    Button:
        text: "Leaderboard"
        on_press: root.parent.show_leaderboard()

    Button:
        text: "Settings"
        on_press: root.parent.show_settings()

    Button:
        text: "Exit"
        on_press: root.parent.confirm_exit()


<PauseScreen>:
    orientation: "vertical"
    spacing: metrics.dp(10)
    size_hint: None, None
    size: metrics.dp(300), metrics.dp(180)
    pos: (Vector(*Window.size) - Vector(*self.size)) / 2
    canvas.before:
        # dims the frozen world and takes the touches meant for it
        Color:
            rgba: 0, 0, 0, 0.5
        Rectangle:
            pos: 0, 0
            size: Window.size

    Label:
        text: "Paused"
        font_size: "26dp"
        size_hint_y: None
        height: metrics.dp(40)

    Button:
        text: "Continue"
        on_press: root.resume()

    Button:
        text: "Main menu"
        on_press: root.go_menu()


<ConfirmScreen>:
    orientation: "vertical"
    spacing: metrics.dp(10)
    size_hint: None, None
    size: metrics.dp(300), metrics.dp(180)
    pos: (Vector(*Window.size) - Vector(*self.size)) / 2
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.5
        Rectangle:
            pos: 0, 0
            size: Window.size

    Label:
        text: "Are you sure?"
        font_size: "26dp"
        size_hint_y: None
        height: metrics.dp(40)

    Button:
        text: "Yes"
        on_press: root.yes()

    Button:
        text: "No"
        on_press: root.no()


<ResultsScreen>:
    orientation: "vertical"
    spacing: metrics.dp(8)
    size_hint: None, None
    size: metrics.dp(380), min(metrics.dp(420), Window.height - metrics.dp(10))
    pos: (Vector(*Window.size) - Vector(*self.size)) / 2

    Label:
        text: "Game over"
        font_size: "26dp"
        size_hint_y: None
        height: metrics.dp(40)

    BoxLayout:
        id: rows
        orientation: "vertical"

    Label:
        id: message
        font_size: "13dp"
        size_hint_y: None
        height: metrics.dp(20)

    Button:
        id: btn_save
        text: "Save to leaderboard"
        size_hint_y: None
        height: metrics.dp(44)
        on_press: root.save_score()

    Button:
        text: "Play again"
        size_hint_y: None
        height: metrics.dp(44)
        on_press: root.play_again()

    Button:
        text: "Main menu"
        size_hint_y: None
        height: metrics.dp(44)
        on_press: root.go_menu()


<NameScreen>:
    orientation: "vertical"
    spacing: metrics.dp(8)
    size_hint: None, None
    size: metrics.dp(340), metrics.dp(210)
    pos: (Vector(*Window.size) - Vector(*self.size)) / 2

    Label:
        id: title
        font_size: "20dp"

    TextInput:
        id: field
        multiline: False
        write_tab: False
        input_filter: lambda text, from_undo: text[:max(0, 12 - len(self.text))]
        font_size: "20dp"
        size_hint_y: None
        height: metrics.dp(44)
        padding: metrics.dp(10), metrics.dp(10)
        on_text_validate: root.accept()

    Button:
        text: "Save"
        size_hint_y: None
        height: metrics.dp(44)
        on_press: root.accept()

    Button:
        text: "Cancel"
        size_hint_y: None
        height: metrics.dp(44)
        on_press: root.cancel()


<LeaderboardScreen>:
    orientation: "vertical"
    spacing: metrics.dp(6)
    size_hint: None, None
    size: metrics.dp(380), min(metrics.dp(400), Window.height - metrics.dp(10))
    pos: (Vector(*Window.size) - Vector(*self.size)) / 2

    Label:
        text: "Leaderboard"
        font_size: "24dp"
        size_hint_y: None
        height: metrics.dp(36)

    BoxLayout:
        id: rows
        orientation: "vertical"

    Button:
        text: "Back"
        size_hint_y: None
        height: metrics.dp(44)
        on_press: root.parent.show_menu()


<SettingsScreen>:
    orientation: "vertical"
    spacing: metrics.dp(10)
    size: metrics.dp(300), metrics.dp(200)
    pos: (Vector(*Window.size) - Vector(*self.size)) / 2

    Button:
        text: "Keyboard layout"
        on_press: root.parent.show_keyboard_settings()

    Button:
        text: "Touch controls"
        on_press: root.parent.show_touch_settings()

    Button:
        text: "Back"
        on_press: root.parent.close_settings()


<TouchSettingsScreen>:
    orientation: "vertical"
    spacing: metrics.dp(10)
    size: metrics.dp(300), metrics.dp(240)
    pos: (Vector(*Window.size) - Vector(*self.size)) / 2

    Button:
        id: btn_mode
        on_press: root.parent.cycle_touch_mode()

    Label:
        id: lbl_scale
        size_hint_y: 0.6

    Slider:
        id: slider_scale
        min: 0.5
        max: 4
        step: 0.05
        value: 1
        on_value: root.set_scale(self.value)
        on_touch_up: if self.collide_point(*args[1].pos): root.save_scale()

    Button:
        text: "Back"
        on_press: root.parent.show_settings()


<KeyboardSettings>:
    orientation: "vertical"
    spacing: metrics.dp(10)
    size: metrics.dp(300), min(metrics.dp(470), Window.height - metrics.dp(10))
    pos: (Vector(*Window.size) - Vector(*self.size)) / 2

    Button:
        id: btn_up
        on_press: root.begin_rebind('up')

    Button:
        id: btn_left
        on_press: root.begin_rebind('left')

    Button:
        id: btn_right
        on_press: root.begin_rebind('right')

    Button:
        id: btn_fire
        on_press: root.begin_rebind('fire')

    Button:
        id: btn_set
        on_press: root.switch_set()

    Button:
        text: "Reset to defaults"
        on_press: root.reset()

    Button:
        text: "Back"
        on_press: root.parent.show_settings()

    Label:
        id: message
        size_hint_y: 0.6


<ScreenButtonsLayout>:
    size: Window.size


<Background@Widget>:
    source: ''
    canvas.before:
        Rectangle:
            size: self.size
            source: self.source


<AnimatedBackground>:
    canvas:
        Rectangle:
            size: self.size
            pos: self.pos
            texture: self.background


<SpacePilgrimGame>:
    Background:
        source: "images/nebula_blue.png"
        size: root.size
    AnimatedBackground:
        source: "images/debris.png"
        size: root.size
