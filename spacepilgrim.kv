#:import metrics kivy.metrics
#:import Window kivy.core.window.Window
#:import Vector kivy.vector.Vector

<Explosion>:
    size: 128, 128
    canvas:
        Ellipse:
            texture: self.texture
            pos: self.pos
            size: self.size


<Asteroid>:
    size: 90, 90
    canvas:
        Ellipse:
            source: "images/asteroid_blue.png"
            pos: self.pos
            size: self.size

    canvas.before:
        PushMatrix
        Rotate:
            angle: self.angle
            origin: self.center
    canvas.after:
        PopMatrix


<Shot>
    size: 10, 10
    canvas:
        Ellipse:
            source: "images/shot1.png"
            pos: self.pos
            size: self.size


<Spaceship>:
    size: 90, 90

    canvas.before:
        PushMatrix
        Rotate:
            angle: self.angle
            origin: self.center
    canvas.after:
        PopMatrix

    canvas:
        Color:
            rgba: 1, 1, 1, 1
        Ellipse:
            texture: self.texture_fly if self.thrust else self.texture_stop
            pos: self.pos
            size: self.size


<SpaceshipStatus>:
    Label:
        # one player: top right. Multiplayer: a touch player's block is in
        # the middle of their side, between the joystick and the FIRE
        # button, turned so that it reads right from their seat (the touch
        # players sit at opposite sides: left one faces right, right one
        # left); keyboard and gamepad players sit in front of the screen and
        # get a column of the top row, in player order
        center_x: metrics.cm(2.7) if root.side == 'left' else (Window.width - metrics.cm(2.7) if root.side == 'right' else (Window.width * (root.column + 0.5) / 4 if root.side == 'top' else Window.width - metrics.dp(210)))
        center_y: Window.height / 2 if root.side in ('left', 'right') else Window.height - 50
        canvas.before:
            PushMatrix
            Rotate:
                angle: -90 if root.side == 'left' else (90 if root.side == 'right' else 0)
                origin: self.center
        canvas.after:
            PopMatrix
        color: root.color
        text: ("Lives {}  Points {}" if root.side == 'top' else "Lives {:<5} Points {}").format(root.spaceship.lives, root.spaceship.points)
        font_size: "17dp" if root.side == 'top' else "23dp"
        font_name: 'data/fonts/RobotoMono-Regular.ttf'


<Menu>:
    orientation: "vertical"
    spacing: metrics.dp(10)
    size: metrics.dp(300), metrics.dp(280)
    pos: (Vector(*Window.size) - Vector(*self.size)) / 2

    Button:
        text: "Single player"
        on_press: root.parent.show_ship_select(1)

    Button:
        text: "Multiplayer"
        on_press: root.parent.show_ship_select(2)

    Button:
        text: "Settings"
        on_press: root.parent.show_settings()

    Button:
        text: "Exit"
        on_press: app.stop()


<SettingsScreen>:
    orientation: "vertical"
    spacing: metrics.dp(10)
    size: metrics.dp(300), metrics.dp(200)
    pos: (Vector(*Window.size) - Vector(*self.size)) / 2

    Button:
        text: "Keyboard layout"
        on_press: root.parent.show_keyboard_settings()

    Button:
        text: "Touch controls"
        on_press: root.parent.show_touch_settings()

    Button:
        text: "Back"
        on_press: root.parent.close_settings()


<TouchSettingsScreen>:
    orientation: "vertical"
    spacing: metrics.dp(10)
    size: metrics.dp(300), metrics.dp(240)
    pos: (Vector(*Window.size) - Vector(*self.size)) / 2

    Button:
        id: btn_mode
        on_press: root.parent.cycle_touch_mode()

    Label:
        id: lbl_scale
        size_hint_y: 0.6

    Slider:
        id: slider_scale
        min: 0.5
        max: 4
        step: 0.05
        value: 1
        on_value: root.set_scale(self.value)
        on_touch_up: if self.collide_point(*args[1].pos): root.save_scale()

    Button:
        text: "Back"
        on_press: root.parent.show_settings()


<KeyboardSettings>:
    orientation: "vertical"
    spacing: metrics.dp(10)
    size: metrics.dp(300), min(metrics.dp(470), Window.height - metrics.dp(10))
    pos: (Vector(*Window.size) - Vector(*self.size)) / 2

    Button:
        id: btn_up
        on_press: root.begin_rebind('up')

    Button:
        id: btn_left
        on_press: root.begin_rebind('left')

    Button:
        id: btn_right
        on_press: root.begin_rebind('right')

    Button:
        id: btn_fire
        on_press: root.begin_rebind('fire')

    Button:
        id: btn_set
        on_press: root.switch_set()

    Button:
        text: "Reset to defaults"
        on_press: root.reset()

    Button:
        text: "Back"
        on_press: root.parent.show_settings()

    Label:
        id: message
        size_hint_y: 0.6


<ScreenButtonsLayout>:
    size: Window.size


<Background@Widget>:
    source: ''
    canvas.before:
        Rectangle:
            size: self.size
            source: self.source


<AnimatedBackground>:
    canvas:
        Rectangle:
            size: self.size
            pos: self.pos
            texture: self.background


<SpacePilgrimGame>:
    Background:
        source: "images/nebula_blue.png"
        size: root.size
    AnimatedBackground:
        source: "images/debris.png"
        size: root.size
