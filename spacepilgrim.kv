#:import metrics kivy.metrics
#:import Window kivy.core.window.Window
#:import Vector kivy.vector.Vector

<Explosion>:
    size: 128, 128
    canvas:
        Ellipse:
            texture: self.texture
            pos: self.pos
            size: self.size


<Asteroid>:
    size: 90, 90
    canvas:
        Ellipse:
            source: "images/asteroid_blue.png"
            pos: self.pos
            size: self.size

    canvas.before:
        PushMatrix
        Rotate:
            angle: self.angle
            origin: self.center
    canvas.after:
        PopMatrix


<Shot>
    size: 10, 10
    canvas:
        Ellipse:
            source: "images/shot1.png"
            pos: self.pos
            size: self.size


<Spaceship>:
    ship_stop: "images/ship_stop.png"
    ship_fly: "images/ship_fly.png"
    size: 90, 90

    canvas.before:
        PushMatrix
        Rotate:
            angle: self.angle
            origin: self.center
    canvas.after:
        PopMatrix

    canvas:
        Ellipse:
            source:
                self.ship_fly if self.thrust else self.ship_stop
            pos: self.pos
            size: self.size


<SpaceshipStatus>:
    Label:
        pos: Vector(*Window.size) - Vector(metrics.dp(260), 100)
        text: "Lives {:<5} Points {}".format(root.spaceship.lives, root.spaceship.points)
        font_size: "23dp"
        font_name: 'data/fonts/RobotoMono-Regular.ttf'


<Menu>:
    orientation: "vertical"
    spacing: metrics.dp(10)
    size: metrics.dp(300), metrics.dp(280)
    pos: (Vector(*Window.size) - Vector(*self.size)) / 2

    Button:
        text: "Single player"
        on_press: root.parent.game_start()

    Button:
        text: "Multiplayer"
        disabled: True

    Button:
        text: "Settings"
        disabled: True

    Button:
        text: "Exit"
        on_press: app.stop()


<ScreenButtonsLayout>:
    size: Window.size
    Button:
        text: "Left"
        on_press: root.parent.press('left')
        on_release: root.parent.release('left')
        pos: metrics.cm(0.5), metrics.cm(0.5)
        size: metrics.cm(1), metrics.cm(1)

    Button:
        text: "Right"
        on_press: root.parent.press('right')
        on_release: root.parent.release('right')
        pos: metrics.cm(2.5), metrics.cm(0.5)
        size: metrics.cm(1), metrics.cm(1)

    Button:
        text: "Up"
        on_press: root.parent.press('up')
        on_release: root.parent.release('up')
        pos: metrics.cm(1.5), metrics.cm(1.5)
        size: metrics.cm(1), metrics.cm(1)

    Button:
        text: "Fire"
        on_press: root.parent.press('fire')
        on_release: root.parent.release('fire')
        pos: root.size[0] - metrics.cm(1.5), metrics.cm(0.5)
        size: metrics.cm(1), metrics.cm(1)


<Background@Widget>:
    source: ''
    canvas.before:
        Rectangle:
            size: self.size
            source: self.source


<AnimatedBackground>:
    canvas:
        Rectangle:
            size: self.size
            pos: self.pos
            texture: self.background


<SpacePilgrimGame>:
    Background:
        source: "images/nebula_blue.png"
        size: root.size
    AnimatedBackground:
        source: "images/debris.png"
        size: root.size
